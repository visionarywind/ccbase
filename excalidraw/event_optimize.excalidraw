      "link": null,
      "locked": false,
      "text": "extract_stream_info(xxx);\n// 1 merge record\nfor (const auto &[_, record_events] : stream_records) {\n  auto first_iter = record_events.begin();\n  // todo - push node here\n  for (auto record_event : record_events) {\n    merged_events.emplace(record_event, <first_iter, event_id>);\n  }\n}\n// 2 process wait\nfor (const auto &[_, wait_events] : stream_waits) {\n  // std::set<record_event> record_events;\n  for (auto wait_event : wait_events) {\n    auto [record_event, event_id] = merged_events[wait_event];\n    // if (record_events.count(record_event) != record_events.end()) {\n    //   continue;\n    // }\n    if (merged_events.find(record_event) != merged_events.end()) {\n      continue;\n    }\n    // todo - push node here\n  }\n}\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "extract_stream_info(xxx);\n// 1 merge record\nfor (const auto &[_, record_events] : stream_records) {\n  auto first_iter = record_events.begin();\n  // todo - push node here\n  for (auto record_event : record_events) {\n    merged_events.emplace(record_event, <first_iter, event_id>);\n  }\n}\n// 2 process wait\nfor (const auto &[_, wait_events] : stream_waits) {\n  // std::set<record_event> record_events;\n  for (auto wait_event : wait_events) {\n    auto [record_event, event_id] = merged_events[wait_event];\n    // if (record_events.count(record_event) != record_events.end()) {\n    //   continue;\n    // }\n    if (merged_events.find(record_event) != merged_events.end()) {\n      continue;\n    }\n    // todo - push node here\n  }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
