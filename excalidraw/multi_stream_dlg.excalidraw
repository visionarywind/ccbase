    {
      "id": "uCTp7Ds7jrPPWDtV5bv9K",
      "type": "text",
      "x": -1000.1706319808968,
      "y": 792.0423604745567,
      "width": 416.458984375,
      "height": 245.36305376376575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5a",
      "roundness": null,
      "seed": 1096398967,
      "version": 1696,
      "versionNonce": 1338514175,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1754035919691,
      "link": null,
      "locked": false,
      "text": "S0: 数据初始化，\nS1: 编译期或执行脚本中，\nS2: 根据下发类型，分别进入S3、S4、S5步骤 \nS3: 下发普通算子，\n    如果算子是消费者，\nS4: 下发record流控event，\nS5: 下发wait流控event，\n     \nS6: 循环执行，回到S2",
      "fontSize": 20.194490021709115,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S0: 数据初始化，\nS1: 编译期或执行脚本中，\nS2: 根据下发类型，分别进入S3、S4、S5步骤 \nS3: 下发普通算子，\n    如果算子是消费者，\nS4: 下发record流控event，\nS5: 下发wait流控event，\n     \nS6: 循环执行，回到S2",
      "autoResize": true,
      "lineHeight": 1.35
    },
